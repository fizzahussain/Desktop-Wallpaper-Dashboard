{
  "name": "desktop-wallpaper-dashboard",
  "version": "0.1.0",
  "description": "A local-first Windows desktop wallpaper dashboard with editable notes and tasks.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": ["electron", "desktop", "dashboard", "sticky-notes", "windows"],
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.fizzahussain.desktopwallpaperdashboard",
    "productName": "Desktop Wallpaper Dashboard",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
